# CROSSFIRE — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Venice (the only model provider — no fallback, ever) ───────────────────
VENICE_API_KEY=

# ─── 1Shot (Base mainnet relayer for the proof run) ─────────────────────────
ONESHOT_API_KEY=
ONESHOT_RELAYER_URL=https://relayer.1shotapi.com/relayers

# ─── RPC endpoints ──────────────────────────────────────────────────────────
# Public endpoints work for dev; swap to Alchemy/Infura later for reliability.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# ─── EOAs (private keys, 0x-prefixed hex) ───────────────────────────────────
# Four separate keys. Generate with `cast wallet new` (Foundry) or viem.
# NEVER reuse a key that holds funds you can't afford to lose.
USER_PRIVATE_KEY=
ORCHESTRATOR_PRIVATE_KEY=
BULL_PRIVATE_KEY=
BEAR_PRIVATE_KEY=

# ─── USDC contract addresses (verify from Circle's official list) ───────────
# Base Sepolia USDC — Circle testnet
USDC_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet USDC — Circle native
USDC_BASE_MAINNET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ─── Market contract (filled after Phase 4 deploys it) ──────────────────────
MARKET_ADDRESS=
